# Configuração de Ambiente Olympus Admin (Vercel & Local)
# Preencha com as credenciais do seu projeto gratuito no Supabase (https://supabase.com)

# URL da sua API do Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima Pública (anon key)
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# Chave de Serviço Secreta (service_role) - Usada apenas em Serverless Functions / Admin seguro
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-service-role
