# =============================================================================
# Olympus-Painel — Configuracao do Backend
# =============================================================================
#
# FONTE DE BUSCA (escolha uma das duas opcoes abaixo):
#
# Opcao 1 — google-maps-scraper.exe (gratuito, sem limite de consultas)
#   1. Acesse: https://github.com/gosom/google-maps-scraper/releases/latest
#   2. Baixe o arquivo "google_maps_scraper-*-windows-amd64.exe"
#   3. Renomeie para "google-maps-scraper.exe"
#   4. Coloque dentro da pasta "backend/" deste projeto
#   (nao precisa configurar nada aqui, o sistema detecta automaticamente)
#
#   OU, se quiser colocar em outro lugar, defina o caminho:
SCRAPER_PATH=

# Opcao 2 — Google Places API (requer conta Google Cloud com billing)
#   1. Acesse: https://console.cloud.google.com/
#   2. Ative a "Places API"
#   3. Crie uma chave em "APIs & Services > Credentials"
#   4. Cole a chave abaixo:
GOOGLE_PLACES_API_KEY=

# =============================================================================
# Outras configuracoes (opcionais)
# =============================================================================

# Nivel de log: DEBUG, INFO, WARNING, ERROR
OLYMPUS_LOG_LEVEL=INFO

# Porta do backend (padrao: 9001)
PORT=9001
